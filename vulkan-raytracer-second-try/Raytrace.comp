float chunkAABBIntersection(vec3 rayOrigin, vec3 rayDir, vec3 invDir){
    
    vec3 t1 = (vec3(ubo.allChunksMin) - rayOrigin) * invDir;
    vec3 t2 = (vec3(ubo.allChunksMax) - rayOrigin) * invDir;
    
    vec3 tmin = min(t1, t2);
    vec3 tmax = max(t1, t2);
    
    float entryDist = max(max(tmin.x, tmin.y), tmin.z);
    float exitDist = min(min(tmax.x, tmax.y), tmax.z);
    //Check if rayOrigin is inside the AABB
    if(entryDist < 0.0 && exitDist > 0.0) {
        return 0.0; 
    }
    if (entryDist > exitDist || exitDist < 0.0) {
        return -1; 
    }
    
    return entryDist+0.0001; 
}
int getAABBEntryAxis(vec3 rayOrigin, vec3 rayDir, vec3 invDir) {
    vec3 t1 = (vec3(ubo.allChunksMin) - rayOrigin) * invDir;
    vec3 t2 = (vec3(ubo.allChunksMax) - rayOrigin) * invDir;
    vec3 tmin = min(t1, t2);

    float entryDist = max(max(tmin.x, tmin.y), tmin.z);
    if (entryDist <= 0.0) return -1; // origin inside AABB or exactly on boundary

    if (tmin.x >= tmin.y && tmin.x >= tmin.z) return 0;
    if (tmin.y >= tmin.z) return 1;
    return 2;
}
uint directionMaskBase(vec3 rayDir) {
    uint directionIndex = (rayDir.x >= 0.0 ? 4u : 0u) |
                          (rayDir.y >= 0.0 ? 2u : 0u) |
                          (rayDir.z >= 0.0 ? 1u : 0u);
    return directionIndex << 6;
}

ivec3 rayVoxelAt(vec3 rayOrigin, vec3 rayDir, float tCurrent) {
    // Select the voxel just beyond a boundary. This is only needed when a ray
    // starts or changes direction; hierarchical steps use integer node bounds.
    return ivec3(floor(rayOrigin + rayDir * tCurrent + sign(rayDir) * 1e-3));
}

void advanceToNodeExit(
    vec3 rayOrigin,
    vec3 rayDir,
    vec3 invDir,
    uint nodeDepth,
    inout ivec3 voxelPos,
    inout float tCurrent,
    out int exitAxis
) {
    // Each tree level covers 4 cells per axis, so an aligned node is found by
    // clearing two coordinate bits per level. This is the 4^3-tree analogue
    // of the parametric node-exit step in Laine/Karras SVO traversal.
    uint coordinateShift = nodeDepth * 2u;
    ivec3 nodeMin = (voxelPos >> coordinateShift) << coordinateShift;
    int nodeSize = int(1u << coordinateShift);
    ivec3 nodeMax = nodeMin + ivec3(nodeSize);

    vec3 exitPlane = vec3(
        rayDir.x > 0.0 ? nodeMax.x : nodeMin.x,
        rayDir.y > 0.0 ? nodeMax.y : nodeMin.y,
        rayDir.z > 0.0 ? nodeMax.z : nodeMin.z
    );
    vec3 tExit = (exitPlane - rayOrigin) * invDir;
    if (abs(rayDir.x) < 1e-20) tExit.x = 1e30;
    if (abs(rayDir.y) < 1e-20) tExit.y = 1e30;
    if (abs(rayDir.z) < 1e-20) tExit.z = 1e30;

    if (tExit.x <= tExit.y && tExit.x <= tExit.z) {
        tCurrent = max(tCurrent, tExit.x);
        exitAxis = 0;
    } else if (tExit.y <= tExit.z) {
        tCurrent = max(tCurrent, tExit.y);
        exitAxis = 1;
    } else {
        tCurrent = max(tCurrent, tExit.z);
        exitAxis = 2;
    }

    // Reconstruct all three coordinates once at the exit. Explicitly set
    // every crossed face so negative rays and edge/corner ties cannot remain
    // in the node because of floating-point rounding.
    float positionBias = max(1e-4, abs(tCurrent) * 2e-7);
    voxelPos = ivec3(floor(rayOrigin + rayDir * (tCurrent + positionBias)));
    float tieTolerance = max(1e-5, abs(tCurrent) * 4e-7);
    if (tExit.x <= tCurrent + tieTolerance) voxelPos.x = rayDir.x > 0.0 ? nodeMax.x : nodeMin.x - 1;
    if (tExit.y <= tCurrent + tieTolerance) voxelPos.y = rayDir.y > 0.0 ? nodeMax.y : nodeMin.y - 1;
    if (tExit.z <= tCurrent + tieTolerance) voxelPos.z = rayDir.z > 0.0 ? nodeMax.z : nodeMin.z - 1;
}
vec4 sampleVoxelTexture(uint voxelValue, vec3 hitPos, vec3 normal, float distance) {
    vec2 uv = getUVForFace(hitPos, normal);
    uint layer = getFaceTextureLayer(voxelValue, normal);
    float lod = log2(max(distance, 1.0)) * 0.05;
    lod = clamp(lod, 0.0, 12.0);
    
    return textureLod(voxelTextureArray, vec3(uv, layer), lod);
}
const float DRAG_MULT = 0.38;
const int ITERATIONS_NORMAL = 16;
// Calculates wave value and its derivative, 
// for the wave direction, position in space, wave frequency and time
vec2 wavedx(vec2 position, vec2 direction, float frequency, float timeshift) {
  float x = dot(direction, position) * frequency + timeshift;
  float wave = exp(sin(x) - 1.0);
  float dx = wave * cos(x);
  return vec2(wave, -dx);
}

float getwaves(vec2 position, int iterations)
{
    const float GOLDEN_ANGLE = 2.39996323;

    float frequency = 0.7;
    float timeMultiplier = 1.0;
    float weight = 1.0;
    float sum = 0.0;
    float weightSum = 0.0;

    for (int i = 0; i < iterations; ++i) {
        float angle = float(i) * GOLDEN_ANGLE;
        vec2 direction = vec2(cos(angle), sin(angle));
        float phase = float(i) * 1.61803399;

        vec2 wave = wavedx(
            position,
            direction,
            frequency,
            ubo.time * timeMultiplier + phase
        );

        position += direction * wave.y * weight * DRAG_MULT;
        sum += wave.x * weight;
        weightSum += weight;

        weight *= 0.8;
        frequency *= 1.324717957;
        timeMultiplier *= 1.071773;
    }
    return sum / weightSum;
}
vec3 getNormal(vec2 pos,int octaves, float e) {
  vec2 ex = vec2(e, 0);
  float H = getwaves(pos.xy, octaves);
  vec3 a = vec3(pos.x, H, pos.y);
  return normalize(
    cross(
      a - vec3(pos.x - e, getwaves(pos.xy - ex.xy, octaves), pos.y),
      a - vec3(pos.x, getwaves(pos.xy + ex.yx, octaves) , pos.y + e)
    )
  );
}
float raytraceAO(vec3 rayOrigin, vec3 rayDir, int maxSteps){
    ancestorstack.stackCount = 0u;
    ancestorstack.lastChunkIndex = UINT32_MAX;
    vec3 invDir = 1.0 / rayDir;
    float tCurrent = 0.0;
    int lastStepAxis = getAABBEntryAxis(rayOrigin, rayDir,invDir);
    ivec3 step = ivec3(sign(rayDir));
    ivec3 voxelPos = rayVoxelAt(rayOrigin, rayDir, tCurrent);
    for (int step_count = 0; step_count < maxSteps; step_count++) {
        ivec3 chunkPos = voxelPos >> 6;
        ivec3 localPos = voxelPos - (chunkPos << 6);
        int chunkIndex = findChunk(chunkPos);
        if (chunkIndex < 0) break;
        uint dirBase = directionMaskBase(rayDir);
        traverseResult res = getVoxel(chunkIndex, localPos, dirBase);
        if(res.voxelValue != 0u && res.voxelValue != 6u) {
            // IMPORTANT, RIGHT NOW LEAVES ARE THE ONLY TRANSPARENT BLOCK AND THUS THIS IS HARDCODED. IF A TRANSPARENT BLOCK IS PRODUCING SHADOWS, THIS IS PROBABLY WHY.
            if(res.voxelValue == 5u){
            vec3 normal = vec3(0.0);
            if (lastStepAxis >= 0) {
                if (lastStepAxis == 0) normal.x = -float(step.x);
                else if (lastStepAxis == 1) normal.y = -float(step.y);
                else normal.z = -float(step.z);
            } else {
                vec3 a = abs(rayDir);
                if (a.x >= a.y && a.x >= a.z) normal.x = -sign(rayDir.x);
                else if (a.y >= a.z) normal.y = -sign(rayDir.y);
                else normal.z = -sign(rayDir.z);
            }
            if(sampleVoxelTexture(res.voxelValue, rayOrigin + rayDir * tCurrent, normal, tCurrent).a > 0.01) {
                return tCurrent;
            }
            }
            else{
                return tCurrent;
                }

        }
        advanceToNodeExit(rayOrigin, rayDir, invDir, res.depth, voxelPos, tCurrent, lastStepAxis);
    }
    return -1.0;
}
RaytraceResult raytrace(vec3 rayOrigin, vec3 rayDir, float startT, bool skipWater, int maxSteps) {

    ancestorstack.stackCount = 0u;
    ancestorstack.lastChunkIndex = UINT32_MAX;

    vec3 invDir = 1.0 / rayDir;
    float tCurrent = max(startT,chunkAABBIntersection(rayOrigin, rayDir,invDir));
    if (tCurrent < 0.0) return RaytraceResult(0u, vec3(0.0), 0.0, vec3(0.0), false);

    int lastStepAxis = getAABBEntryAxis(rayOrigin, rayDir,invDir);
    ivec3 step = ivec3(sign(rayDir));

    ivec3 voxelPos = rayVoxelAt(rayOrigin, rayDir, tCurrent);
    bool inWater = false;
    bool passedThroughWater = false;
	ivec3 cachedChunkPos = ivec3(0);
	int cachedChunkIndex = -1;
	bool hasCachedChunk = false;
    uint dirBase = directionMaskBase(rayDir);
    for (int step_count = 0; step_count < maxSteps; step_count++) {
        
        // CHUNK_SIZE is fixed at 64. Signed right shift gives floor division
        // for negative coordinates without three int/float conversions and
        // floor operations in the hottest traversal loop.
        ivec3 chunkPos = voxelPos >> 6;
        ivec3 localPos = voxelPos - (chunkPos << 6);
        if (!hasCachedChunk || any(notEqual(chunkPos, cachedChunkPos))) {
			cachedChunkIndex = findChunk(chunkPos);
			if (cachedChunkIndex < 0) break;
			cachedChunkPos = chunkPos;
			hasCachedChunk = true;
		}
        int chunkIndex = cachedChunkIndex;
        // Beam optimization is too coarse for distances above 400 voxels so it is stopped there.
        traverseResult res = pushConstants.isBeam == 1u && tCurrent > 400.0
            ? traverseResult(1u, 0u)
            : getVoxel(chunkIndex, localPos, dirBase);
        // Hit voxel logic
        if (res.voxelValue != 0u) {
            vec3 normal = vec3(0.0);
            if (lastStepAxis >= 0) {
                if (lastStepAxis == 0) normal.x = -float(step.x);
                else if (lastStepAxis == 1) normal.y = -float(step.y);
                else normal.z = -float(step.z);
            } else {
                vec3 a = abs(rayDir);
                if (a.x >= a.y && a.x >= a.z) normal.x = -sign(rayDir.x);
                else if (a.y >= a.z) normal.y = -sign(rayDir.y);
                else normal.z = -sign(rayDir.z);
            }

            vec3 rayHitPos = rayOrigin + rayDir * tCurrent;
            // The full-resolution water path never consumes its voxel texture;
            // the low-resolution beam path still does.
            vec4 texColor = vec4(1.0);
			if (res.voxelValue != 6u || pushConstants.isBeam == 1u) {
				texColor = sampleVoxelTexture(res.voxelValue, rayHitPos, normal, tCurrent);
			}
            if(res.voxelValue ==6){
                passedThroughWater = true;
                if(pushConstants.isBeam==1) {
                    return RaytraceResult(res.voxelValue, normal, tCurrent, texColor.rgb, true);
                }

                if(!skipWater && !inWater) {
                    if (lastStepAxis < 0 && tCurrent <= 0.001) {
                        inWater = true;
                    }
                    else {
                        return RaytraceResult(res.voxelValue, normal, tCurrent, texColor.rgb, true);
                    }
                }
            }
            else if (texColor.a > 0.01||pushConstants.isBeam==1) {
                return RaytraceResult(res.voxelValue, normal, tCurrent, texColor.rgb, passedThroughWater);
            }
        }

        

        advanceToNodeExit(rayOrigin, rayDir, invDir, res.depth, voxelPos, tCurrent, lastStepAxis);
        }

    return RaytraceResult(0u, vec3(0.0), 0.0, vec3(0.0), passedThroughWater);
}
float hash12(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}
vec2 sampleDisk(vec2 randomValue) {
    float radius = sqrt(randomValue.x);
    float angle = 6.28318530718 * randomValue.y;
    return radius * vec2(cos(angle), sin(angle));
}
vec3 sampleSunDirection(vec3 sunDir, vec2 pixel, vec2 temporalJitter) {
    vec3 helper = abs(sunDir.y) < 0.999
        ? vec3(0.0, 1.0, 0.0)
        : vec3(1.0, 0.0, 0.0);
    vec3 tangent = normalize(cross(helper, sunDir));
    vec3 bitangent = cross(sunDir, tangent);
    float random1 = hash12(pixel + temporalJitter * 173.0);
    float random2 = hash12(pixel.yx + temporalJitter * 311.0 + 19.0);
    vec2 disk = sampleDisk(vec2(random1, random2));
    // Approximately the sun's apparent angular radius.
    float angularRadius = radians(0.27);
    return normalize(
        sunDir +
        tangent * disk.x * angularRadius +
        bitangent * disk.y * angularRadius
    );
}
vec3 cosineHemisphere(vec3 normal, vec2 randomValue)
{
    float phi = 6.28318530718 * randomValue.x;
    float radius = sqrt(randomValue.y);

    vec3 localDirection = vec3(
        radius * cos(phi),
        sqrt(max(0.0, 1.0 - randomValue.y)),
        radius * sin(phi)
    );

    vec3 helper = abs(normal.y) < 0.999
        ? vec3(0.0, 1.0, 0.0)
        : vec3(1.0, 0.0, 0.0);

    vec3 tangent = normalize(cross(helper, normal));
    vec3 bitangent = cross(normal, tangent);

    return normalize(
        tangent * localDirection.x +
        normal * localDirection.y +
        bitangent * localDirection.z
    );
}
float radicalInverseVdC(uint bits)
{
    return float(bitfieldReverse(bits)) * 2.3283064365386963e-10;
}
float calculateAO(
    vec3 hitPosition,
    vec3 normal,
    vec2 pixel,
    vec2 temporalJitter
) {
    const int SAMPLE_COUNT = 4;
    const float AO_RADIUS = 3.0;

    float occlusion = 0.0;
    vec3 origin = hitPosition + normal * 0.02;
    vec2 sequenceRotation = vec2(
        hash12(pixel + temporalJitter * 113.0),
        hash12(pixel.yx + temporalJitter * 271.0 + 19.0)
    );

    for (int i = 0; i < SAMPLE_COUNT; ++i) {
        vec2 randomValue = fract(vec2(
            (float(i) + 0.5) / float(SAMPLE_COUNT),
            radicalInverseVdC(uint(i))
        ) + sequenceRotation);

        vec3 direction = cosineHemisphere(normal, randomValue);

        float aoDistance = raytraceAO(origin, direction, int(AO_RADIUS));

        if (aoDistance >= 0.0) {
            float distanceWeight = 1.0 - aoDistance / AO_RADIUS;
            occlusion += distanceWeight;
        }
    }

    float ao = 1.0 - occlusion / float(SAMPLE_COUNT);
    ao = pow(clamp(ao, 0.0, 1.0), 3);
    return mix(0.01, 1.0, ao);
}
vec3 shadeRayResult(RaytraceResult result,vec3 hitPos, vec3 skyColor, vec3 sunDir, vec2 pixel, bool castShadows, bool temporalAO) {
    if (result.voxelValue == 0u) return skyColor;

    vec3 normal = normalize(result.normal);
    float diffuse = max(dot(normal, sunDir), 0.0);
    float sunVisible = 1.0;

    if (diffuse > 0.0 && castShadows) {
        vec3 shadowOrigin = hitPos + normal * 0.002;
        float shadowDistance = raytraceAO(shadowOrigin, sunDir, 64);
        sunVisible = (shadowDistance < 0.0) ? 1.0 : 0.0;
    }
float ao = calculateAO(
    hitPos,
    normalize(result.normal),
    pixel,
    temporalAO ? ubo.jitter : vec2(0.0)
);
vec3 ambientLight = vec3(0.38, 0.40, 0.44);
    vec3 directLight =SUN_COLOR * (0.85 * diffuse * sunVisible);
    return result.color * (ambientLight + directLight) * ao;
}

vec3 aces_tonemap(vec3 color) {  
  mat3 m1 = mat3(
    0.59719, 0.07600, 0.02840,
    0.35458, 0.90834, 0.13383,
    0.04823, 0.01566, 0.83777
  );
  mat3 m2 = mat3(
    1.60475, -0.10208, -0.00327,
    -0.53108,  1.10813, -0.07276,
    -0.07367, -0.00605,  1.07602
  );
  vec3 v = m1 * color;  
  vec3 a = v * (v + 0.0245786) - 0.000090537;
  vec3 b = v * (0.983729 * v + 0.4329510) + 0.238081;
  return pow(clamp(m2 * (a / b), 0.0, 1.0), vec3(1.0 / 2.2));  
}
vec3 extra_cheap_atmosphere(vec3 raydir, vec3 sundir) {
raydir.y = max(raydir.y, 0.0);
  //sundir.y = max(sundir.y, -0.07);
  float special_trick = 1.0 / (raydir.y * 1.0 + 0.1);
  float special_trick2 = 1.0 / (sundir.y * 11.0 + 1.0);
  float raysundt = pow(abs(dot(sundir, raydir)), 2.0);
  float sundt = pow(max(0.0, dot(sundir, raydir)), 8.0);
  float mymie = sundt * special_trick * 0.2;
  vec3 suncolor = mix(vec3(1.0), max(vec3(0.0), vec3(1.0) - vec3(5.5, 13.0, 22.4) / 22.4), special_trick2);
  vec3 bluesky= vec3(5.5, 13.0, 22.4) / 22.4 * suncolor;
  vec3 bluesky2 = max(vec3(0.0), bluesky - vec3(5.5, 13.0, 22.4) * 0.002 * (special_trick + -6.0 * sundir.y * sundir.y));
  bluesky2 *= special_trick * (0.24 + raysundt * 0.24);
  bluesky2 *= (1.0 + 1.0 * pow(1.0 - raydir.y, 3.0));
  bluesky2 = bluesky2 / (bluesky2 + vec3(1.0));
  return bluesky2;
}
float DistributionGGX(vec3 N, vec3 H, float roughness) {
	float a = roughness * roughness;
	float a2 = a * a;
	float NdotH = max(dot(N, H), 0.0);
	float NdotH2 = NdotH * NdotH;
	float denom = (NdotH2 * (a2 - 1.0) + 1.0);
	return a2 / (PI * denom * denom);
}

float GeometrySchlickGGX(float NdotV, float roughness) {
	float r = roughness + 1.0;
	float k = (r * r) / 8.0;
	return NdotV / (NdotV * (1.0 - k) + k);
}

float GeometrySmith(vec3 N, vec3 V, vec3 L, float roughness) {
	float NdotV = max(dot(N, V), 0.0);
	float NdotL = max(dot(N, L), 0.0);
	float ggxV = GeometrySchlickGGX(NdotV, roughness);
	float ggxL = GeometrySchlickGGX(NdotL, roughness);
	return ggxV * ggxL;
}

vec3 FresnelSchlick(float cosTheta, vec3 F0) {
	return F0 + (1.0 - F0) * pow(1.0 - cosTheta, 5.0);
}
vec3 specular(vec3 N, vec3 L, vec3 V, float roughness) {
	vec3 H = normalize(V + L);
	vec3 F0 = vec3(0.02);

	float D = DistributionGGX(N, H, roughness);
	float G = GeometrySmith(N, V, L, roughness);
	vec3 F = FresnelSchlick(max(dot(H, V), 0.0), F0);

	float NdotV = max(dot(N, V), 0.0);
	float NdotL = max(dot(N, L), 0.0);
	vec3 specular =  (D * G * F) / max(4.0 * NdotV * NdotL, 0.001);
	return specular*SUN_COLOR*NdotL;
}
const vec3 SEA_BASE = vec3(0.18,0.09,0.0);
const vec3 SEA_WATER_COLOR = vec3(0.6,0.9,0.8)*0.6;
float diffuse(vec3 n,vec3 l,float p) {
    return pow(dot(n,l) * 0.4 + 0.6,p);
}
vec3 applyWaterAttenuation(vec3 incidentColor,vec3 waterColor, float waterDistance) {
    // Beer-Lambert extinction per world-space block. Red light is absorbed
    // fastest, which shifts distant objects toward blue/green.
    const vec3 ABSORPTION = vec3(0.012,0.05,0.08)*3;

    float distanceInWater = max(waterDistance, 0.0);
    vec3 transmittance = exp(-ABSORPTION * distanceInWater);
    return mix(waterColor, incidentColor, transmittance);
}
float getFresnel(vec3 normal, vec3 viewDir) {
    float cosTheta = clamp(dot(normal, -viewDir), 0.0, 1.0);
    const float WATER_F0 = 0.204;
    return WATER_F0 + (1.0 - WATER_F0) * pow(1.0 - cosTheta, 5.0);
}
vec3 colorWater(vec3 refractedColor, vec3 reflectedColor,vec3 normal,float waterDistance, vec3 sunDir, vec3 viewDir, vec2 pixel) {
      vec3 waterColor = SEA_BASE + diffuse(normal, sunDir, 80.0) * SEA_WATER_COLOR * 0.12; 
    vec3 attenuatedRefractedColor = applyWaterAttenuation(refractedColor,waterColor, waterDistance);
    
    
    
    float fresnel = getFresnel(normal, viewDir);
    vec3 color = mix(attenuatedRefractedColor, reflectedColor, fresnel);
    //color += specular(normal, sunDir, -viewDir, 0.2)*3;
    return color;
}
void main()
{  
ancestorstack.stackCount = 0u;
ancestorstack.lastChunkIndex = 0xffffffffu; // invalid index
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size  = imageSize(img);
    ivec2 outputSize = pushConstants.isBeam == 1u ? imageSize(beamImage) : size;

    if (pixel.x >= outputSize.x || pixel.y >= outputSize.y)
        return;

    vec2 currentUV = (vec2(pixel) + 0.5) / vec2(size);
    
    vec2 jitteredUV = currentUV;
    if(pushConstants.isBeam==1){
        jitteredUV =vec2(pixel) / vec2(size) * vec2(pushConstants.beamResolutionDivisor);
    } else {
        
        float previousDepth = imageLoad(previousDepthBuffer, pixel).r;
        if (previousDepth != 0.0) {
            jitteredUV += ubo.jitter.xy / vec2(size);
        }
    }
    vec2 ndc = jitteredUV * 2.0 - 1.0;
    ndc.y *= -1.0;
    vec4 clip = vec4(ndc, -1.0, 1.0);

    vec4 eye = ubo.inverseProj * clip;
    eye.z = -1.0;
    eye.w = 0.0;

    vec4 world = ubo.inverseView * eye;
    vec3 rayDir = normalize(world.xyz);
    vec3 rayOrigin = ubo.cameraPos;
    
    if(pushConstants.isBeam==1) {
        RaytraceResult result = raytrace(rayOrigin, rayDir, 0.0, false, 1000);
        if(result.voxelValue != 0u) {
            imageStore(beamImage, pixel, vec4(result.tHit, 0.0, 0.0, 1.0));
        } else {
            // Zero is a valid near distance and caused the full-resolution
            // pass to restart at the camera whenever any corner beam missed.
            imageStore(beamImage, pixel, vec4(1e30, 0.0, 0.0, 1.0));
        }
        return;
    }
    ivec2 beamSize = imageSize(beamImage);
    ivec2 beamPixel = pixel / int(pushConstants.beamResolutionDivisor);
    ivec2 beamPixelRight = min(beamPixel + ivec2(1, 0), beamSize - 1);
    ivec2 beamPixelDown = min(beamPixel + ivec2(0, 1), beamSize - 1);
    ivec2 beamPixelDiagonal = min(beamPixel + ivec2(1, 1), beamSize - 1);
    float cornerBeamTs[4] = {
        imageLoad(beamImage, beamPixel).r,
        imageLoad(beamImage, beamPixelRight).r,
        imageLoad(beamImage, beamPixelDown).r,
        imageLoad(beamImage, beamPixelDiagonal).r
    };
    float beamT = 9999.0;
    for(int i=0;i<4;i++) {
        if(cornerBeamTs[i]<beamT) {
            beamT = cornerBeamTs[i];
        }
    }
    vec3 sunDir = normalize(vec3(0.5, 0.5, 0.5));
    vec3 skyColor = extra_cheap_atmosphere(rayDir,sunDir).bgr;
    float startT = beamT < 1e29 ? max(beamT - 1.0, 0.0) : 1000.0;
    RaytraceResult result = raytrace(rayOrigin, rayDir, startT, false, 1000);
    vec3 shadowDir = sampleSunDirection(normalize(sunDir), vec2(pixel), ubo.jitter.xy);
    vec3 finalColor;
    if (result.voxelValue == 6u) {
        vec3 waterHitPos = rayOrigin + rayDir * result.tHit;
        vec3 geometricNormal = result.normal;
        float distFactor = clamp(result.tHit / 100.0, 0.0, 1.0);
        float angleFactor = clamp(dot(-rayDir, geometricNormal), 0.5, 1.0);
        int waterLOD = int(mix(4.0, 16.0, (1.0 - distFactor) * angleFactor));
        vec3 waveNormal = geometricNormal.y > 0.5
            ? getNormal(waterHitPos.xz, waterLOD, 0.001)
            : geometricNormal;
        vec3 waterNormal = normalize(mix(geometricNormal, waveNormal, 0.25));
        vec3 reflectedDir = normalize(reflect(rayDir, normalize(mix(geometricNormal, waterNormal, 0.1))));

        // Keep the reflection above the actual flat surface.
        float reflectedHeight = dot(reflectedDir, geometricNormal);
        if (reflectedHeight < 0.02) {
            reflectedDir = normalize(reflectedDir + geometricNormal * (0.02 - reflectedHeight));
        }

        const float AIR_TO_WATER_ETA = 1.0 / 1.333;
        vec3 refractedDir = normalize(refract(rayDir, waterNormal, AIR_TO_WATER_ETA));
        vec3 reflectedColor;
                vec3 reflectedSkyColor = extra_cheap_atmosphere(reflectedDir, sunDir).bgr;
        if(getFresnel(waterNormal, rayDir) <0.3) {
            reflectedColor = reflectedSkyColor;
        }
        else {
                    RaytraceResult reflectedResult = raytrace(
            waterHitPos+ geometricNormal * 0.02, reflectedDir, 0.0, true, 1000);
            reflectedColor = shadeRayResult(reflectedResult,waterHitPos + geometricNormal * 0.02 + reflectedDir * reflectedResult.tHit, reflectedSkyColor, shadowDir, pixel, false, false);
        }
        RaytraceResult refractedResult = raytrace(
            waterHitPos - geometricNormal * 0.02, refractedDir, 0.0, true, 1000);
        vec3 refractedSkyColor = extra_cheap_atmosphere(refractedDir, sunDir).bgr;
        // Water bypasses TAA, so keep its AO sequence stable instead of
        // introducing frame-to-frame shimmer that cannot be accumulated.
        vec3 refractedColor = shadeRayResult(refractedResult,waterHitPos - geometricNormal * 0.02 + refractedDir * refractedResult.tHit, refractedSkyColor, shadowDir, pixel, refractedResult.tHit < 30, false);

        // This secondary ray begins at the surface, so its hit distance is
        // the distance traveled through the water to the refracted hit.
        float waterDistance = refractedResult.voxelValue != 0u
            ? refractedResult.tHit
            : 0.0;
        finalColor = colorWater(refractedColor, reflectedColor, waterNormal, waterDistance, sunDir, rayDir, vec2(pixel));
        // Apply distance fog
        finalColor = mix(finalColor, skyColor, 1.0 - exp(-result.tHit * 0.0006));
    }
    else if (result.voxelValue != 0u) {
        float horizontalDistance = length(rayOrigin.xz - (rayOrigin + rayDir * result.tHit).xz);
        // If the voxel is too far away, don't cast shadows. Adjust for height as it's easier to notice the shadow seam when high up
        bool castShadows = (horizontalDistance - rayOrigin.y*2.0) < 0.0;
        vec3 litColor = shadeRayResult(result,rayOrigin + rayDir * result.tHit, skyColor, shadowDir, pixel, castShadows, true);
        if (result.passedThroughWater) {
            // Rays beginning underwater do not cross the reflective surface,
            // but they still lose light over the path to the visible object.
            // Preserve the neutral normal used when starting underwater.
            vec3 waterColor = SEA_BASE + diffuse(vec3(0.0), sunDir, 80.0) * SEA_WATER_COLOR * 0.12;
            litColor = applyWaterAttenuation(litColor,waterColor, result.tHit);
        }
        finalColor = litColor;
        // Apply distance fog
        if(!result.passedThroughWater){
            finalColor = mix(finalColor, skyColor, 1.0 - exp(-result.tHit * 0.0006));
        }
    }
    else {
        result.tHit=999.0;
        finalColor = skyColor;
        if(result.passedThroughWater) {
            vec3 waterColor = SEA_BASE + diffuse(vec3(0.0), sunDir, 80.0) * SEA_WATER_COLOR * 0.12;
            finalColor = applyWaterAttenuation(skyColor,waterColor, result.tHit);
        }
        
    }
    imageStore(img, pixel, vec4(aces_tonemap(finalColor), 1.0));
    vec4 prevClip = ubo.previousProj * ubo.previousView * vec4(rayOrigin + rayDir * result.tHit, 1.0);
    vec2 prevNDC  = prevClip.xy / prevClip.w;
    vec2 prevUV   = vec2(prevNDC.x, -prevNDC.y) * 0.5 + 0.5;
    imageStore(velocityBuffer, pixel, vec4(prevUV - currentUV, 0.0, 1.0));
    if(result.passedThroughWater || result.voxelValue == 0u){
           imageStore(depthBuffer, pixel, vec4(0.0, 0.0, 0.0, 1.0));
    }
    else{
        imageStore(depthBuffer, pixel, vec4(result.tHit, 0.0, 0.0, 1.0));
    }


}
