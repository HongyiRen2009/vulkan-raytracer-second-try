uint hashChunkPos(ivec3 pos) {
    const uint p1 = 73856093u;
    const uint p2 = 19349663u;
    const uint p3 = 83492791u;
    
    uint hash = (uint(pos.x) * p1) ^ (uint(pos.y) * p2) ^ (uint(pos.z) * p3);
    
    hash ^= hash >> 16;
    hash *= 0x85ebca6bu;
    hash ^= hash >> 13;
    hash *= 0xc2b2ae35u;
    hash ^= hash >> 16;

    return hash % 10000; 
}
uint getFaceTextureLayer(uint id, vec3 normal) {
    switch (id) {
        case 1u: return normal.y > 0.5 ? 0u :
                        normal.y < -0.5 ? 1u : 4u; // Grass
        case 2u: return 1u;                       // Dirt
        case 3u: return 3u;                       // Stone
        case 4u: return abs(normal.y) > 0.5 ? 5u : 2u;
        default: return id >= 5u && id <= 9u ? id + 1u : 0u;
    }
}
uint normalToFaceIndex(vec3 normal) {
    if(normal.z>0.5) return 0u;
    if(normal.z<-0.5) return 1u;
    if(normal.x<-0.5) return 2u;
    if(normal.x>0.5) return 3u;
    if(normal.y>0.5) return 4u;
    if(normal.y<-0.5) return 5u;
    return 0u; // default case, should not happen for axis-aligned normals
}
int findChunk(ivec3 chunkPos) {
    uint hash = hashChunkPos(chunkPos);
    
    for (uint i = 0; i < 100u; i++) {
        uint index = (hash + i) % 10000u;
        

        uint slotState = chunkSSBO.chunkData[index].valid;
        if (slotState == 0u) {
            // Never-used slots terminate an open-addressing lookup. Deleted
            // slots use the tombstone state (2) and must continue probing.
            return -1;
        }
        if (slotState == 1u && ivec3(chunkSSBO.chunkData[index].chunkPos) == chunkPos) {
            return int(index);
        }
    }
    return -1;
}
uint depthToStepSize(uint depth){
    return depth > 0u ? (1u << (depth * 2u)) : 1u; // 4^depth
}
bool isPosInNode(ivec3 pos,ivec3 nodePos, uint depth){
    uint nodeSize = depthToStepSize(depth);
    return all(greaterThanEqual(pos, nodePos)) && all(lessThan(pos, nodePos + ivec3(int(nodeSize))));
}
uint packNodePosAndDepth(vec3 nodePos, uint depth){
    return (uint(nodePos.x) & 0x3FFu) | ((uint(nodePos.y) & 0x3FFu) << 10u) | ((uint(nodePos.z) & 0x3FFu) << 20u) | ((depth & 0x3u) << 30u);
}
uint unpackNodePosAndDepth(uint packedNodePosAndDepth, out ivec3 nodePos){
    nodePos.x = int(packedNodePosAndDepth & 0x3FFu);
    nodePos.y = int((packedNodePosAndDepth >> 10u) & 0x3FFu);
    nodePos.z = int((packedNodePosAndDepth >> 20u) & 0x3FFu);
    return (packedNodePosAndDepth >> 30u) & 0x3u; // depth
}
traverseResult traverseTree(uint nodeIdx, ivec3 localPos, uint chunkBaseIdx, uint oneNodeBaseIdx, uint startDepth, uint dirBase) {
    Node currentNode = voxelSSBO.nodes[nodeIdx];

    for (int level = int(startDepth) - 1; level >= 0; --level) {
        if (currentNode.mask == 0ul) return traverseResult(0u, uint(level + 1));
        if (currentNode.blockId != 0u) return traverseResult(currentNode.blockId, uint(level + 1));



        if(level>0) {

        uvec3 voxelLocalPos = (uvec3(localPos) >> uint(level * 2)) & uvec3(3u);

        uint posIndex = voxelLocalPos.x * 16u + voxelLocalPos.y * 4u + voxelLocalPos.z;
//        uint64_t directionMask = ubo.directionMasks[dirBase + posIndex];
//        if((currentNode.mask&directionMask)==0u) {
//            // No occupied child exists in the ray-facing octant of this
//            // node. The ray can leave the entire parent, not just the child
//            // containing its current position.
//            return traverseResult(0u, uint(level + 1));
//        }
        }
        uvec3 child = (uvec3(localPos) >> uint(level * 2)) & uvec3(3u);
        uint bitPos = child.x * 16u + child.y * 4u + child.z;
        uint64_t bit = (1ul << bitPos);

        if ((currentNode.mask & bit) == 0ul) return traverseResult(0u, uint(level));

        uint64_t masked = currentNode.mask & (bit - 1ul);
        uint childOffset = bitCount(uint(masked)) + bitCount(uint(masked >> 32));

        if (level == 0) {
            if (oneNodeBaseIdx == UINT32_MAX) return traverseResult(0u, 0u);
            uint leafIdx = oneNodeBaseIdx + currentNode.firstChildIndex + childOffset;
            return traverseResult(oneNodeSSBO.nodeIds[leafIdx], 0u);
        }

        uint childIdx = chunkBaseIdx + currentNode.firstChildIndex + childOffset;
        currentNode = voxelSSBO.nodes[childIdx];

        ivec3 nodeOrigin = (localPos >> (level * 2)) << (level * 2);
        if (ancestorstack.stackCount < 3u) {
            ancestorstack.nodes[ancestorstack.stackCount] = nodeInfo(packNodePosAndDepth(vec3(nodeOrigin), uint(level)), childIdx);
            ancestorstack.stackCount++;
        }
    }

    return traverseResult(currentNode.blockId, 0u);
}
traverseResult getVoxel(uint chunkIndex, ivec3 localPos, uint dirBase) {
    if (localPos.x < 0 || localPos.x >= int(ubo.CHUNK_SIZE) ||
        localPos.y < 0 || localPos.y >= int(ubo.CHUNK_SIZE) ||
        localPos.z < 0 || localPos.z >= int(ubo.CHUNK_SIZE)) {
        return traverseResult(0u, 0u);
    }

    ChunkData cd = chunkSSBO.chunkData[chunkIndex];
    if (cd.gpuSlot == UINT32_MAX) return traverseResult(0u, 0u);

    uint rootNodeIdx = cd.gpuSlot;
    uint oneNodeRootIdx = cd.oneNodeSlot;
    uint rootDepth = uint(log2(ubo.CHUNK_SIZE) / 2);

    if (ancestorstack.lastChunkIndex != chunkIndex) {
        ancestorstack.stackCount = 0u;
        ancestorstack.lastChunkIndex = chunkIndex;
    }

    if (ancestorstack.stackCount == 0u) {
        ancestorstack.nodes[0] = nodeInfo(packNodePosAndDepth(vec3(0), rootDepth), rootNodeIdx);
        ancestorstack.stackCount = 1u;
    }

    while (ancestorstack.stackCount > 0u) {
        nodeInfo current = ancestorstack.nodes[ancestorstack.stackCount - 1u];
        ivec3 nodePos;
        uint depth = unpackNodePosAndDepth(current.packedNodePosAndDepth, nodePos);
        if (isPosInNode(localPos, nodePos, depth)) {
            return traverseTree(current.nodeIndex, localPos, rootNodeIdx, oneNodeRootIdx, depth, dirBase);
        }
        ancestorstack.stackCount--;
    }

    ancestorstack.nodes[0] = nodeInfo(packNodePosAndDepth(vec3(0), rootDepth), rootNodeIdx);
    ancestorstack.stackCount = 1u;
    return traverseTree(rootNodeIdx, localPos, rootNodeIdx, oneNodeRootIdx, rootDepth, dirBase);
}
vec2 getUVForFace(vec3 hitPos, vec3 normal) {
    vec3 localHit = hitPos - floor(hitPos);
    vec2 uv;
    
    if (abs(normal.x) > 0.5) {
        uv = vec2(1.0 - localHit.z, localHit.y);
    }
    else if (abs(normal.y) > 0.5) {
        uv = vec2(localHit.x, localHit.z);
    }
    else {
        uv = vec2(localHit.x, localHit.y);
    }
    uv.y = 1.0 - uv.y;
    return uv;
}

