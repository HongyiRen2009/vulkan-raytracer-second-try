#version 460
#extension GL_KHR_vulkan_glsl: enable
#extension GL_EXT_shader_explicit_arithmetic_types: enable
struct blockData{
    uvec4 face0123;   // +Z, -Z, -X, +X
    uvec4 face45pad;  // +Y, -Y, pad, pad
};
struct traverseResult{
    uint voxelValue;
    uint depth;
};
struct ChunkData{
    vec2 chunkPos;
    uint gpuSlot;
    uint valid;
};
struct Node {
    uint64_t mask;
    uint32_t blockId;
    uint32_t firstChildIndex;
};
struct nodeInfo{
    ivec3 nodePos;
    uint depth;
    uint nodeIndex;
    };
struct AncestorStack{
    uint32_t stackCount;
    nodeInfo nodes[8];
    uint lastChunkIndex;
};
layout(local_size_x = 16, local_size_y = 16) in;
layout(binding = 0, rgba8) uniform writeonly image2D img;
layout(binding = 1) uniform UniformBufferObject
{
    mat4 view;
    mat4 proj;
    vec3 cameraPos;
    uint CHUNK_SIZE;
    blockData blockDataArray[256];
    ivec3 allChunksMin;
    ivec3 allChunksMax;
} ubo;
layout(binding=2) buffer ChunkSSBO
{
    ChunkData chunkData[10000];
} chunkSSBO;
layout(std430, binding=3) buffer SVOBuffer
{
    Node nodes[];
} voxelSSBO;
layout(binding=4) uniform sampler2DArray voxelTextureArray;
const uint treeMaxDepth = 3;
AncestorStack ancestorstack;
struct RaytraceResult {
    uint voxelValue;
    vec3 normal;
    vec3 rayPos;
    vec4 color;
};
uint hashChunkPos(ivec2 pos) {
    const uint p1 = 73856093u;
    const uint p2 = 19349663u;
    
    uint hash = (uint(pos.x) * p1) ^ (uint(pos.y) * p2);
    
    hash ^= hash >> 16;
    hash *= 0x85ebca6bu;
    hash ^= hash >> 13;
    hash *= 0xc2b2ae35u;
    hash ^= hash >> 16;

    return hash % 10000; 
}
uint normalToFaceIndex(vec3 normal) {
    if(normal.z>0.5) return 0u;
    if(normal.z<-0.5) return 1u;
    if(normal.x<-0.5) return 2u;
    if(normal.x>0.5) return 3u;
    if(normal.y>0.5) return 4u;
    if(normal.y<-0.5) return 5u;
}
int findChunk(ivec2 chunkPos) {
    uint hash = hashChunkPos(chunkPos);
    
    for (uint i = 0; i < 100u; i++) {
        uint index = (hash + i) % 10000u;
        

        if (chunkSSBO.chunkData[index].valid==1u&&ivec2(chunkSSBO.chunkData[index].chunkPos) == chunkPos) {
            return int(index);
        }
    }
    return -1;
}
uint depthToStepSize(uint depth){
    return depth > 0u ? (1u << (depth * 2u)) : 1u; // 4^depth
}
bool isPosInNode(ivec3 pos,ivec3 nodePos, uint depth){
    uint nodeSize = depthToStepSize(depth);
    return all(greaterThanEqual(pos, nodePos)) && all(lessThan(pos, nodePos + ivec3(int(nodeSize))));
}
traverseResult traverseTree(uint nodeIdx, ivec3 localPos, uint chunkBaseIdx, uint startDepth) {
    Node currentNode = voxelSSBO.nodes[nodeIdx];

    // Traverse from this node's depth down to leaves
    for (int level = int(startDepth) - 1; level >= 0; --level) {
        if (currentNode.mask == 0ul) return traverseResult(0u, uint(level));
        if (currentNode.blockId != 0u) return traverseResult(currentNode.blockId, uint(level + 1));

        uvec3 child = (uvec3(localPos) >> uint(level * 2)) & uvec3(3u);
        uint bitPos = child.x * 16u + child.y * 4u + child.z;
        uint64_t bit = (1ul << bitPos);

        if ((currentNode.mask & bit) == 0ul) return traverseResult(0u, uint(level));

        uint64_t masked = currentNode.mask & (bit - 1ul);
        uint childOffset = bitCount(uint(masked)) + bitCount(uint(masked >> 32));

        // firstChildIndex is chunk-local; convert to global SSBO index using chunk base
        uint childIdx = chunkBaseIdx + currentNode.firstChildIndex + childOffset;

        currentNode = voxelSSBO.nodes[childIdx];

        // Cache this child node in LOCAL chunk coordinates (not world)
        ivec3 nodeOrigin = (localPos >> (level * 2)) << (level * 2);
        if (ancestorstack.stackCount < 8u) {
            ancestorstack.nodes[ancestorstack.stackCount] = nodeInfo(nodeOrigin, uint(level), childIdx);
            ancestorstack.stackCount++;
        }
    }

    return traverseResult(currentNode.blockId, 0u);
}

traverseResult getVoxel(uint chunkIndex, ivec3 localPos) {
    if (localPos.x < 0 || localPos.x >= int(ubo.CHUNK_SIZE) ||
        localPos.y < 0 || localPos.y >= int(ubo.CHUNK_SIZE) ||
        localPos.z < 0 || localPos.z >= int(ubo.CHUNK_SIZE)) {
        return traverseResult(0u, 0u);
    }

    uint chunkVolume = ubo.CHUNK_SIZE * ubo.CHUNK_SIZE * ubo.CHUNK_SIZE;
    ChunkData cd = chunkSSBO.chunkData[chunkIndex];
    uint rootNodeIdx = cd.gpuSlot * chunkVolume;
    uint rootDepth = uint(log2(ubo.CHUNK_SIZE) / 2);

    // Reset cache when chunk changes
    if (ancestorstack.lastChunkIndex != chunkIndex) {
        ancestorstack.stackCount = 0u;
        ancestorstack.lastChunkIndex = chunkIndex;
    }

    // Initialize root in LOCAL space
    if (ancestorstack.stackCount == 0u) {
        ancestorstack.nodes[0] = nodeInfo(ivec3(0), rootDepth, rootNodeIdx);
        ancestorstack.stackCount = 1u;
    }

    // Pop until we find an ancestor containing localPos
    while (ancestorstack.stackCount > 0u) {
        nodeInfo current = ancestorstack.nodes[ancestorstack.stackCount - 1u];
        if (isPosInNode(localPos, current.nodePos, current.depth)) {
            return traverseTree(current.nodeIndex, localPos, rootNodeIdx, current.depth);
        }
        ancestorstack.stackCount--;
    }

    // Fallback if something dumb happens
    ancestorstack.nodes[0] = nodeInfo(ivec3(0), rootDepth, rootNodeIdx);
    ancestorstack.stackCount = 1u;
    return traverseTree(rootNodeIdx, localPos, rootNodeIdx, rootDepth);
}
vec2 getUVForFace(vec3 hitPos, vec3 normal) {
    vec3 localHit = hitPos - floor(hitPos);
    vec2 uv;
    
    if (abs(normal.x) > 0.5) {
        uv = vec2(1.0 - localHit.z, localHit.y);
    }
    else if (abs(normal.y) > 0.5) {
        uv = vec2(localHit.x, localHit.z);
    }
    else {
        uv = vec2(localHit.x, localHit.y);
    }
    uv.y = 1.0 - uv.y;
    return uv;
}

uint getFaceTextureLayer(uint voxelValue, vec3 normal) {
    uint face = normalToFaceIndex(normal);
    blockData b = ubo.blockDataArray[voxelValue];
    return (face < 4u) ? b.face0123[face] : b.face45pad[face - 4u];
}

vec4 sampleVoxelTexture(uint voxelValue, vec3 hitPos, vec3 normal) {
    vec2 uv = getUVForFace(hitPos, normal);
    uint layer = getFaceTextureLayer(voxelValue, normal);
    return texture(voxelTextureArray, vec3(uv, layer));
}
float chunkAABBIntersection(vec3 rayOrigin, vec3 rayDir){
    vec3 invDir = 1.0 / rayDir;
    
    vec3 t1 = (vec3(ubo.allChunksMin) - rayOrigin) * invDir;
    vec3 t2 = (vec3(ubo.allChunksMax) - rayOrigin) * invDir;
    
    vec3 tmin = min(t1, t2);
    vec3 tmax = max(t1, t2);
    
    float entryDist = max(max(tmin.x, tmin.y), tmin.z);
    float exitDist = min(min(tmax.x, tmax.y), tmax.z);
    //Check if rayOrigin is inside the AABB
    if(entryDist < 0.0 && exitDist > 0.0) {
        return 0.0; 
    }
    if (entryDist > exitDist || exitDist < 0.0) {
        return -1; 
    }
    
    return entryDist+0.0001; 
}
int getAABBEntryAxis(vec3 rayOrigin, vec3 rayDir) {
    vec3 invDir = 1.0 / rayDir;
    vec3 t1 = (vec3(ubo.allChunksMin) - rayOrigin) * invDir;
    vec3 t2 = (vec3(ubo.allChunksMax) - rayOrigin) * invDir;
    vec3 tmin = min(t1, t2);

    float entryDist = max(max(tmin.x, tmin.y), tmin.z);
    if (entryDist <= 0.0) return -1; // origin inside AABB or exactly on boundary

    if (tmin.x >= tmin.y && tmin.x >= tmin.z) return 0;
    if (tmin.y >= tmin.z) return 1;
    return 2;
}

RaytraceResult raytrace(vec3 rayOrigin, vec3 rayDir) {
    const int MAX_STEPS = 1024;
    float AABBresult = chunkAABBIntersection(rayOrigin, rayDir);
    if (AABBresult < 0.0) return RaytraceResult(0u, vec3(0.0), vec3(0.0), vec4(0.0));

    vec3 startPos = rayOrigin + rayDir * AABBresult;
    int lastStepAxis = getAABBEntryAxis(rayOrigin, rayDir);

    ivec3 voxelPos = ivec3(floor(startPos));
    ivec3 step = ivec3(sign(rayDir));
    vec3 tDelta = abs(1.0 / rayDir);

    vec3 tMax;
    for (int i = 0; i < 3; i++) {
        if (rayDir[i] > 0.0) tMax[i] = (floor(startPos[i]) + 1.0 - startPos[i]) / rayDir[i];
        else if (rayDir[i] < 0.0) tMax[i] = (floor(startPos[i]) - startPos[i]) / rayDir[i];
        else tMax[i] = 1e30;
    }

    for (int step_count = 0; step_count < MAX_STEPS; step_count++) {
        ivec2 chunkPos = ivec2(
            floor(float(voxelPos.x) / float(ubo.CHUNK_SIZE)),
            floor(float(voxelPos.z) / float(ubo.CHUNK_SIZE))
        );
        ivec3 localPos = voxelPos - ivec3(chunkPos.x, 0, chunkPos.y) * int(ubo.CHUNK_SIZE);
        int chunkIndex = findChunk(chunkPos);

        if (chunkIndex >= 0) {
            traverseResult res = getVoxel(chunkIndex, localPos);
            uint voxelValue = res.voxelValue;
            if (voxelValue != 0u) {
                float tHit = 0.0;
                vec3 normal = vec3(0.0);

                if (lastStepAxis >= 0) {
                    tHit = max(tMax[lastStepAxis] - tDelta[lastStepAxis], 0.0);
                    if (lastStepAxis == 0) normal.x = -float(step.x);
                    else if (lastStepAxis == 1) normal.y = -float(step.y);
                    else normal.z = -float(step.z);
                } else {
                    vec3 a = abs(rayDir);
                    if (a.x >= a.y && a.x >= a.z) normal.x = -sign(rayDir.x);
                    else if (a.y >= a.z) normal.y = -sign(rayDir.y);
                    else normal.z = -sign(rayDir.z);
                }

                vec3 rayHitPos = startPos + rayDir * tHit;
                vec4 texColor = sampleVoxelTexture(voxelValue, rayHitPos, normal);

                if (texColor.a > 0.01) {
                    return RaytraceResult(voxelValue, normal, rayHitPos, texColor);
                }
            }
        } else {
            break;
        }

        if (tMax.x <= tMax.y && tMax.x <= tMax.z) {
            voxelPos.x += step.x;
            tMax.x += tDelta.x;
            lastStepAxis = 0;
        } else if (tMax.y <= tMax.z) {
            voxelPos.y += step.y;
            tMax.y += tDelta.y;
            lastStepAxis = 1;
        } else {
            voxelPos.z += step.z;
            tMax.z += tDelta.z;
            lastStepAxis = 2;
        }
    }

    return RaytraceResult(0u, vec3(0.0), vec3(0.0), vec4(0.0));
}

void main()
{  
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size  = imageSize(img);

    if (pixel.x >= size.x || pixel.y >= size.y)
        return;

    vec2 uv = vec2(pixel) / vec2(size);
    vec2 ndc = uv * 2.0 - 1.0;
    ndc.y *= -1.0;
    vec4 clip = vec4(ndc, -1.0, 1.0);

    vec4 eye = inverse(ubo.proj) * clip;
    eye.z = -1.0;
    eye.w = 0.0;

    vec4 world = inverse(ubo.view) * eye;
    vec3 rayDir = normalize(world.xyz);
    vec3 rayOrigin = ubo.cameraPos;
    
    RaytraceResult result = raytrace(rayOrigin, rayDir);
    
    if (result.voxelValue != 0u) {
        // Apply simple lighting to texture
        vec3 normalizedNormal = normalize(result.normal);
        float brightness = dot(normalizedNormal, vec3(0.0, 1.0, 0.0)) * 0.4 + 0.6;
        vec4 litColor = vec4(result.color.rgb * brightness, result.color.a);
        imageStore(img, pixel, litColor);
    } else {
        imageStore(img, pixel, vec4(1.0, 0.749, 0.0, 1.0));
    }
}