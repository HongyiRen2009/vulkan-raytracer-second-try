#version 460
#extension GL_KHR_vulkan_glsl: enable
const uint CHUNK_SSBO_DATA_SIZE = 16*16*256;
struct ChunkData{
    vec2 chunkPos;
    uint gpuOffset;
};
layout(local_size_x = 16, local_size_y = 16) in;
layout(binding = 0, rgba8) uniform writeonly image2D img;
layout(binding = 1) uniform UniformBufferObject
{
    mat4 view;
    mat4 proj;
    vec3 cameraPos;
    uint CHUNK_SIZE;
    uint CHUNK_HEIGHT;
} ubo;
layout(binding=2) buffer ChunkSSBO
{
    ChunkData chunkData[1000];
} chunkSSBO;
layout(binding=3) buffer VoxelSSBO
{
    uint voxels[CHUNK_SSBO_DATA_SIZE*1000];
} voxelSSBO;

struct RaytraceResult {
    uint voxelValue;
    vec3 normal;
};

uint hashChunkPos(ivec2 pos) {
    uint hash = uint(pos.x * 73856093) ^ uint(pos.y * 19349663);
    return hash % 1000u;
}

int findChunk(ivec2 chunkPos) {
    uint hash = hashChunkPos(chunkPos);
    
    for (int i = 0; i < 10; i++) {
        uint index = (hash + uint(i)) % 1000u;
        if (ivec2(chunkSSBO.chunkData[index].chunkPos) == chunkPos) {
            return int(index);
        }
        if (chunkSSBO.chunkData[index].gpuOffset == 0u) {
            return -1;
        }
    }
    return -1;
}

uint getVoxel(uint chunkIndex, ivec3 localPos)
{
    if (localPos.x < 0 || localPos.x >= ubo.CHUNK_SIZE || 
        localPos.z < 0 || localPos.z >= ubo.CHUNK_SIZE || 
        localPos.y < 0 || localPos.y >= ubo.CHUNK_HEIGHT) {
        return 0u;
    }
    uint voxelIndex = chunkSSBO.chunkData[chunkIndex].gpuOffset + 
                      uint(localPos.x * ubo.CHUNK_HEIGHT*ubo.CHUNK_SIZE + localPos.y * ubo.CHUNK_SIZE + localPos.z);
    return voxelSSBO.voxels[voxelIndex];
}

RaytraceResult raytrace(vec3 rayOrigin, vec3 rayDir) {
    const int MAX_STEPS = 256; 
    int lastStepAxis = 0; // 0 for X, 1 for Y, 2 for Z
    ivec3 voxelPos = ivec3(floor(rayOrigin));
    ivec3 step = ivec3(sign(rayDir));
    
    vec3 tDelta = abs(1.0 / rayDir);
    
    vec3 tMax;
    for (int i = 0; i < 3; i++) {
        if (rayDir[i] > 0.0) {
            tMax[i] = (floor(rayOrigin[i]) + 1.0 - rayOrigin[i]) / rayDir[i];
        } else if (rayDir[i] < 0.0) {
            tMax[i] = (floor(rayOrigin[i]) - rayOrigin[i]) / rayDir[i];
        } else {
            tMax[i] = 1e30;
        }
    }
    
    for (int step_count = 0; step_count < MAX_STEPS; step_count++) {
        ivec2 chunkPos = ivec2(floor(float(voxelPos.x) / float(ubo.CHUNK_SIZE)), floor(float(voxelPos.z) / float(ubo.CHUNK_SIZE)));
        ivec3 localPos = voxelPos - ivec3(chunkPos.x, 0, chunkPos.y) * int(ubo.CHUNK_SIZE);
        
        int chunkIndex = findChunk(chunkPos);
        
        if (chunkIndex >= 0) {
            uint voxelValue = getVoxel(uint(chunkIndex), localPos);
            if (voxelValue != 0u) {
                vec3 normal = vec3(0.0);
                // Use the axis we just stepped through
                if (lastStepAxis == 0) normal.x = -float(step.x);
                else if (lastStepAxis == 1) normal.y = -float(step.y);
                else if (lastStepAxis == 2) normal.z = -float(step.z);
    
                return RaytraceResult(voxelValue, normal);
            }

        }
        

        if (tMax.x < tMax.y) {
            if (tMax.x < tMax.z) {
                voxelPos.x += step.x;
                tMax.x += tDelta.x;
                lastStepAxis = 0; 
            } else {
                voxelPos.z += step.z;
                tMax.z += tDelta.z;
                lastStepAxis = 2; 
            }
        } else {
            if (tMax.y < tMax.z) {
                voxelPos.y += step.y;
                tMax.y += tDelta.y;
                lastStepAxis = 1;
            } else {
                voxelPos.z += step.z;
                tMax.z += tDelta.z;
                lastStepAxis = 2; 
            }
        }

    }
    
    return RaytraceResult(0u, vec3(0.0));
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size  = imageSize(img);

    if (pixel.x >= size.x || pixel.y >= size.y)
        return;

    vec2 uv = vec2(pixel) / vec2(size);
    vec2 ndc = uv * 2.0 - 1.0;
    ndc.y *= -1.0;
    vec4 clip = vec4(ndc, -1.0, 1.0);

    vec4 eye = inverse(ubo.proj) * clip;
    eye.z = -1.0;
    eye.w = 0.0;

    vec4 world = inverse(ubo.view) * eye;
    vec3 rayDir = normalize(world.xyz);
    vec3 rayOrigin = ubo.cameraPos;
    
    RaytraceResult result = raytrace(rayOrigin, rayDir);
    
    if (result.voxelValue != 0u) {
        vec3 normalizedNormal = normalize(result.normal);
        float brightness = dot(normalizedNormal,vec3(0.0, 1.0, 0.0)) * 0.5 + 0.5;
        imageStore(img, pixel, vec4(0.0,brightness,0.0, 1.0));
    } else {
        imageStore(img, pixel, vec4(0.0, 0.0, 0.0, 1.0));
    }
}