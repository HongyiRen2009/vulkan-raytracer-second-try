    uint64_t mask;
    uint32_t blockId;
    uint32_t firstChildIndex;
};
struct nodeInfo{
    ivec3 nodePos;
    uint depth;
    uint nodeIndex;
    };
struct AncestorStack{
    uint32_t stackCount;
    nodeInfo nodes[8];
    uint lastChunkIndex;
};
