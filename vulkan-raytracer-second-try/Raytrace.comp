#version 460
#extension GL_KHR_vulkan_glsl: enable
#extension GL_EXT_shader_explicit_arithmetic_types: enable
struct blockData{
    uvec4 face0123;   // +Z, -Z, -X, +X
    uvec4 face45pad;  // +Y, -Y, pad, pad
};
struct traverseResult{
    uint voxelValue;
    uint depth;
};
struct ChunkData{
    vec3 chunkPos;
    uint gpuSlot;
    uint valid;
    uint oneNodeSlot;
};
struct Node {
    uint64_t mask;
    uint32_t blockId;
    uint32_t firstChildIndex;
};
struct nodeInfo{
    ivec3 nodePos;
    uint depth;
    uint nodeIndex;
    };
struct AncestorStack{
    uint32_t stackCount;
    nodeInfo nodes[8];
    uint lastChunkIndex;
};
layout(local_size_x = 16, local_size_y = 16) in;
layout(push_constant) uniform PushConstants {
    uint beamResolutionDivisor;
    uint computeToggle;
    uint isBeam;
} pushConstants;
layout(binding = 0, rgba8) uniform writeonly image2D img;
layout(binding = 1, r32f) uniform image2D beamImage;
layout(std140, binding = 2) uniform UniformBufferObject
{
    mat4 view;
    mat4 proj;
    vec3 cameraPos;
    uint CHUNK_SIZE;
    blockData blockDataArray[256];
    uint64_t twoWideRegionMasks[27];
    uint64_t directionMasks[512];
    ivec3 allChunksMin;
    ivec3 allChunksMax;
} ubo;
layout(binding=3) buffer ChunkSSBO
{
    ChunkData chunkData[10000];
} chunkSSBO;
layout(std430, binding=4) buffer SVOBuffer
{
    Node nodes[];
} voxelSSBO;
layout (binding = 5) buffer OneNodeBuffer{
    uint32_t nodeIds[];
} oneNodeSSBO;
layout(binding=6) uniform sampler2DArray voxelTextureArray;
const uint treeMaxDepth = 3;
const uint32_t UINT32_MAX = 0xffffffffu;
AncestorStack ancestorstack;
struct RaytraceResult {
    uint voxelValue;
    vec3 normal;
    float tHit;
    vec4 color;
};
uint hashChunkPos(ivec3 pos) {
    const uint p1 = 73856093u;
    const uint p2 = 19349663u;
    const uint p3 = 83492791u;
    
    uint hash = (uint(pos.x) * p1) ^ (uint(pos.y) * p2) ^ (uint(pos.z) * p3);
    
    hash ^= hash >> 16;
    hash *= 0x85ebca6bu;
    hash ^= hash >> 13;
    hash *= 0xc2b2ae35u;
    hash ^= hash >> 16;

    return hash % 10000; 
}
uint normalToFaceIndex(vec3 normal) {
    if(normal.z>0.5) return 0u;
    if(normal.z<-0.5) return 1u;
    if(normal.x<-0.5) return 2u;
    if(normal.x>0.5) return 3u;
    if(normal.y>0.5) return 4u;
    if(normal.y<-0.5) return 5u;
    return 0u; // default case, should not happen for axis-aligned normals
}
int findChunk(ivec3 chunkPos) {
    uint hash = hashChunkPos(chunkPos);
    
    for (uint i = 0; i < 100u; i++) {
        uint index = (hash + i) % 10000u;
        

        if (chunkSSBO.chunkData[index].valid==1u&&ivec3(chunkSSBO.chunkData[index].chunkPos) == chunkPos) {
            return int(index);
        }
    }
    return -1;
}
uint depthToStepSize(uint depth){
    return depth > 0u ? (1u << (depth * 2u)) : 1u; // 4^depth
}
bool isPosInNode(ivec3 pos,ivec3 nodePos, uint depth){
    uint nodeSize = depthToStepSize(depth);
    return all(greaterThanEqual(pos, nodePos)) && all(lessThan(pos, nodePos + ivec3(int(nodeSize))));
}
traverseResult traverseTree(uint nodeIdx, ivec3 localPos, uint chunkBaseIdx, uint oneNodeBaseIdx, uint startDepth,float tCurrent,vec3 rayDir) {
    if(pushConstants.isBeam==1&&tCurrent>400) {
        return traverseResult(1u, 0u);
    }
    Node currentNode = voxelSSBO.nodes[nodeIdx];
        ivec3 voxelDir = ivec3(sign(rayDir.x + 1e-6), sign(rayDir.y + 1e-6), sign(rayDir.z + 1e-6));
    uint dirIndex = (uint((voxelDir.x + 1) >> 1) << 2) |
                    (uint((voxelDir.y + 1) >> 1) << 1) |
                     uint((voxelDir.z + 1) >> 1);
    uint dirBase = dirIndex << 6; // *64
    for (int level = int(startDepth) - 1; level >= 0; --level) {
        if (currentNode.mask == 0ul) return traverseResult(0u, uint(level));
        if (currentNode.blockId != 0u) return traverseResult(currentNode.blockId, uint(level + 1));



        if(level>0) {

        uvec3 voxelLocalPos = (uvec3(localPos) >> uint(level * 2)) & uvec3(3u);

        uint posIndex = voxelLocalPos.x * 16u + voxelLocalPos.y * 4u + voxelLocalPos.z;
        uint64_t directionMask = ubo.directionMasks[dirBase + posIndex];
        if((currentNode.mask&directionMask)==0u) {
            return traverseResult(0u, uint(level));
        }
        }
        uvec3 child = (uvec3(localPos) >> uint(level * 2)) & uvec3(3u);
        uint bitPos = child.x * 16u + child.y * 4u + child.z;
        uint64_t bit = (1ul << bitPos);

        if ((currentNode.mask & bit) == 0ul) return traverseResult(0u, uint(level));

        uint64_t masked = currentNode.mask & (bit - 1ul);
        uint childOffset = bitCount(uint(masked)) + bitCount(uint(masked >> 32));

        if (level == 0) {
            if (oneNodeBaseIdx == UINT32_MAX) return traverseResult(0u, 0u);
            uint leafIdx = oneNodeBaseIdx + currentNode.firstChildIndex + childOffset;
            return traverseResult(oneNodeSSBO.nodeIds[leafIdx], 0u);
        }

        uint childIdx = chunkBaseIdx + currentNode.firstChildIndex + childOffset;
        currentNode = voxelSSBO.nodes[childIdx];

        ivec3 nodeOrigin = (localPos >> (level * 2)) << (level * 2);
        if (ancestorstack.stackCount < 8u) {
            ancestorstack.nodes[ancestorstack.stackCount] = nodeInfo(nodeOrigin, uint(level), childIdx);
            ancestorstack.stackCount++;
        }
    }

    return traverseResult(currentNode.blockId, 0u);
}
traverseResult getVoxel(uint chunkIndex, ivec3 localPos,float tCurrent,vec3 rayDir) {
    if (localPos.x < 0 || localPos.x >= int(ubo.CHUNK_SIZE) ||
        localPos.y < 0 || localPos.y >= int(ubo.CHUNK_SIZE) ||
        localPos.z < 0 || localPos.z >= int(ubo.CHUNK_SIZE)) {
        return traverseResult(0u, 0u);
    }

    ChunkData cd = chunkSSBO.chunkData[chunkIndex];
    if (cd.gpuSlot == UINT32_MAX) return traverseResult(0u, 0u);

    uint rootNodeIdx = cd.gpuSlot;
    uint oneNodeRootIdx = cd.oneNodeSlot;
    uint rootDepth = uint(log2(ubo.CHUNK_SIZE) / 2);

    if (ancestorstack.lastChunkIndex != chunkIndex) {
        ancestorstack.stackCount = 0u;
        ancestorstack.lastChunkIndex = chunkIndex;
    }

    if (ancestorstack.stackCount == 0u) {
        ancestorstack.nodes[0] = nodeInfo(ivec3(0), rootDepth, rootNodeIdx);
        ancestorstack.stackCount = 1u;
    }

    while (ancestorstack.stackCount > 0u) {
        nodeInfo current = ancestorstack.nodes[ancestorstack.stackCount - 1u];
        if (isPosInNode(localPos, current.nodePos, current.depth)) {
            return traverseTree(current.nodeIndex, localPos, rootNodeIdx, oneNodeRootIdx, current.depth,tCurrent,rayDir);
        }
        ancestorstack.stackCount--;
    }

    ancestorstack.nodes[0] = nodeInfo(ivec3(0), rootDepth, rootNodeIdx);
    ancestorstack.stackCount = 1u;
    return traverseTree(rootNodeIdx, localPos, rootNodeIdx, oneNodeRootIdx, rootDepth,tCurrent,rayDir);
}
vec2 getUVForFace(vec3 hitPos, vec3 normal) {
    vec3 localHit = hitPos - floor(hitPos);
    vec2 uv;
    
    if (abs(normal.x) > 0.5) {
        uv = vec2(1.0 - localHit.z, localHit.y);
    }
    else if (abs(normal.y) > 0.5) {
        uv = vec2(localHit.x, localHit.z);
    }
    else {
        uv = vec2(localHit.x, localHit.y);
    }
    uv.y = 1.0 - uv.y;
    return uv;
}

uint getFaceTextureLayer(uint voxelValue, vec3 normal) {
    uint face = normalToFaceIndex(normal);
    blockData b = ubo.blockDataArray[voxelValue];
    return (face < 4u) ? b.face0123[face] : b.face45pad[face - 4u];
}
float chunkAABBIntersection(vec3 rayOrigin, vec3 rayDir, vec3 invDir){
    
    vec3 t1 = (vec3(ubo.allChunksMin) - rayOrigin) * invDir;
    vec3 t2 = (vec3(ubo.allChunksMax) - rayOrigin) * invDir;
    
    vec3 tmin = min(t1, t2);
    vec3 tmax = max(t1, t2);
    
    float entryDist = max(max(tmin.x, tmin.y), tmin.z);
    float exitDist = min(min(tmax.x, tmax.y), tmax.z);
    //Check if rayOrigin is inside the AABB
    if(entryDist < 0.0 && exitDist > 0.0) {
        return 0.0; 
    }
    if (entryDist > exitDist || exitDist < 0.0) {
        return -1; 
    }
    
    return entryDist+0.0001; 
}
int getAABBEntryAxis(vec3 rayOrigin, vec3 rayDir, vec3 invDir) {
    vec3 t1 = (vec3(ubo.allChunksMin) - rayOrigin) * invDir;
    vec3 t2 = (vec3(ubo.allChunksMax) - rayOrigin) * invDir;
    vec3 tmin = min(t1, t2);

    float entryDist = max(max(tmin.x, tmin.y), tmin.z);
    if (entryDist <= 0.0) return -1; // origin inside AABB or exactly on boundary

    if (tmin.x >= tmin.y && tmin.x >= tmin.z) return 0;
    if (tmin.y >= tmin.z) return 1;
    return 2;
}
void rebuildDDAForStepSize(
    vec3 rayOrigin,
    vec3 rayDir,
    float tCurrent,
    uint stepSize,
    out ivec3 voxelPos,
    out vec3 tMax,
    out vec3 tDelta
) {
    float s = float(stepSize);
    vec3 p = rayOrigin + rayDir * tCurrent;

    // scale epsilon based on position
    float maxAbsP = max(max(abs(p.x), abs(p.y)), abs(p.z));
    float relEps = max(1e-4,maxAbsP * 1.1920929e-7);          // scaled float epsilon
    p += sign(rayDir) * relEps;

    vec3 cellMin = floor(p / s) * s;
    vec3 cellMax = cellMin + vec3(s);

    voxelPos = ivec3(cellMin);

    vec3 nextBoundary;
    nextBoundary.x = (rayDir.x > 0.0) ? cellMax.x : cellMin.x;
    nextBoundary.y = (rayDir.y > 0.0) ? cellMax.y : cellMin.y;
    nextBoundary.z = (rayDir.z > 0.0) ? cellMax.z : cellMin.z;

    tMax.x = (rayDir.x != 0.0) ? (nextBoundary.x - rayOrigin.x) / rayDir.x : 1e30;
    tMax.y = (rayDir.y != 0.0) ? (nextBoundary.y - rayOrigin.y) / rayDir.y : 1e30;
    tMax.z = (rayDir.z != 0.0) ? (nextBoundary.z - rayOrigin.z) / rayDir.z : 1e30;

    tDelta.x = (rayDir.x != 0.0) ? abs(s / rayDir.x) : 1e30;
    tDelta.y = (rayDir.y != 0.0) ? abs(s / rayDir.y) : 1e30;
    tDelta.z = (rayDir.z != 0.0) ? abs(s / rayDir.z) : 1e30;
}
vec4 sampleVoxelTexture(uint voxelValue, vec3 hitPos, vec3 normal, float distance) {
    vec2 uv = getUVForFace(hitPos, normal);
    uint layer = getFaceTextureLayer(voxelValue, normal);
    float lod = log2(max(distance, 1.0)) * 0.02;
    lod = clamp(lod, 0.0, 12.0);
    
    return textureLod(voxelTextureArray, vec3(uv, layer), lod);
}
RaytraceResult raytrace(vec3 rayOrigin, vec3 rayDir,float startT) {
    const int MAX_STEPS = 1024;
    vec3 invDir = 1.0 / rayDir;
    float tCurrent = max(startT,chunkAABBIntersection(rayOrigin, rayDir,invDir));
    if (tCurrent < 0.0) return RaytraceResult(0u, vec3(0.0), 0, vec4(0.0));

    int lastStepAxis = getAABBEntryAxis(rayOrigin, rayDir,invDir);
    ivec3 step = ivec3(sign(rayDir));

    uint stepSize = 1;
    ivec3 voxelPos;
    vec3 tMax, tDelta;
    rebuildDDAForStepSize(rayOrigin, rayDir, tCurrent, stepSize, voxelPos, tMax, tDelta);

    for (int step_count = 0; step_count < MAX_STEPS; step_count++) {

        ivec3 chunkPos = ivec3(
            floor(float(voxelPos.x) / float(ubo.CHUNK_SIZE)),
            floor(float(voxelPos.y) / float(ubo.CHUNK_SIZE)),
            floor(float(voxelPos.z) / float(ubo.CHUNK_SIZE))
        );
        ivec3 localPos = voxelPos - chunkPos * int(ubo.CHUNK_SIZE);

        int chunkIndex = findChunk(chunkPos);
        if (chunkIndex < 0) break;

        traverseResult res = getVoxel(chunkIndex, localPos,tCurrent,rayDir);
        uint newStepSize = depthToStepSize(res.depth);
        if (newStepSize != stepSize) {
            stepSize = newStepSize;
            rebuildDDAForStepSize(rayOrigin, rayDir, tCurrent, stepSize, voxelPos, tMax, tDelta);
            continue;
        }

        if (res.voxelValue != 0u) {
            vec3 normal = vec3(0.0);
            if (lastStepAxis >= 0) {
                if (lastStepAxis == 0) normal.x = -float(step.x);
                else if (lastStepAxis == 1) normal.y = -float(step.y);
                else normal.z = -float(step.z);
            } else {
                vec3 a = abs(rayDir);
                if (a.x >= a.y && a.x >= a.z) normal.x = -sign(rayDir.x);
                else if (a.y >= a.z) normal.y = -sign(rayDir.y);
                else normal.z = -sign(rayDir.z);
            }

            vec3 rayHitPos = rayOrigin + rayDir * tCurrent;
            float rayDistance = tCurrent;
            vec4 texColor = sampleVoxelTexture(res.voxelValue, rayHitPos, normal, rayDistance);
            if (texColor.a > 0.01||pushConstants.isBeam==1) {
                return RaytraceResult(res.voxelValue, normal, tCurrent, texColor);
            }
        }

        

        if (tMax.x <= tMax.y && tMax.x <= tMax.z) {
            tCurrent = tMax.x;
            voxelPos.x += step.x * int(stepSize);
            tMax.x += tDelta.x;
            lastStepAxis = 0;
        } else if (tMax.y <= tMax.z) {
            tCurrent = tMax.y;
            voxelPos.y += step.y * int(stepSize);
            tMax.y += tDelta.y;
            lastStepAxis = 1;
        } else {
            tCurrent = tMax.z;
            voxelPos.z += step.z * int(stepSize);
            tMax.z += tDelta.z; 
            lastStepAxis = 2;
        }
        }

    return RaytraceResult(0u, vec3(0.0), 0, vec4(0.0));
}
void main()
{  
ancestorstack.stackCount = 0u;
ancestorstack.lastChunkIndex = 0xffffffffu; // invalid index to force reset on first access
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size  = imageSize(img);

    if (pixel.x >= size.x || pixel.y >= size.y)
        return;

    vec2 uv = vec2(pixel) / vec2(size);
    if(pushConstants.isBeam==1){
        uv =vec2(pixel) / vec2(size) * vec2(pushConstants.beamResolutionDivisor);
    }
    vec2 ndc = uv * 2.0 - 1.0;
    ndc.y *= -1.0;
    vec4 clip = vec4(ndc, -1.0, 1.0);

    vec4 eye = inverse(ubo.proj) * clip;
    eye.z = -1.0;
    eye.w = 0.0;

    vec4 world = inverse(ubo.view) * eye;
    vec3 rayDir = normalize(world.xyz);
    vec3 rayOrigin = ubo.cameraPos;
    
    if(pushConstants.isBeam==1) {
        RaytraceResult result = raytrace(rayOrigin, rayDir, 0.0);
        if(result.voxelValue != 0u) {
            imageStore(beamImage, pixel, vec4(result.tHit, 0.0, 0.0, 1.0));
        } else {
            imageStore(beamImage, pixel, vec4(0.0, 0.0, 0.0, 1.0));
        }
        return;
    }
    ivec2 beamPixel = pixel / int(pushConstants.beamResolutionDivisor);
    float cornerBeamTs[4] = {
        imageLoad(beamImage, beamPixel).r,
        imageLoad(beamImage, beamPixel + ivec2(1, 0)).r,
        imageLoad(beamImage, beamPixel + ivec2(0, 1)).r,
        imageLoad(beamImage, beamPixel + ivec2(1, 1)).r
    };
    float beamT = 9999.0;
    for(int i=0;i<4;i++) {
        if(cornerBeamTs[i]<beamT) {
            beamT = cornerBeamTs[i];
        }
    }

    float startT = (beamT >= 0.0) ? beamT-1.0 : 0.0;
    
    RaytraceResult result = raytrace(rayOrigin, rayDir, startT);

    if (result.voxelValue != 0u) {
                vec3 normalizedNormal = normalize(result.normal);
        float brightness = dot(normalizedNormal, vec3(0.0, 1.0, 0.0)) * 0.4 + 0.6;
        vec4 litColor = vec4(result.color.rgb * brightness, result.color.a);
            imageStore(img, pixel, litColor);
        } else {
        imageStore(img, pixel, vec4(1.0, 0.749, 0.0, 1.0));
    }
}