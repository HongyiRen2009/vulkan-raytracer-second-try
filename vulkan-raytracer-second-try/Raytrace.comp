#version 460
#extension GL_KHR_vulkan_glsl: enable
#extension GL_EXT_shader_explicit_arithmetic_types: enable
struct blockData{
    uvec4 face0123;   // +Z, -Z, -X, +X
    uvec4 face45pad;  // +Y, -Y, pad, pad
};

struct ChunkData{
    vec2 chunkPos;
    uint gpuSlot;
    uint valid;
};
struct Node {
    uint64_t mask;
    uint32_t blockId;
    uint32_t firstChildIndex;
};
layout(local_size_x = 16, local_size_y = 16) in;
layout(binding = 0, rgba8) uniform writeonly image2D img;
layout(binding = 1) uniform UniformBufferObject
{
    mat4 view;
    mat4 proj;
    vec3 cameraPos;
    uint CHUNK_SIZE;
    blockData blockDataArray[256];
} ubo;
layout(binding=2) buffer ChunkSSBO
{
    ChunkData chunkData[10000];
} chunkSSBO;
layout(std430, binding=3) buffer SVOBuffer
{
    Node nodes[];
} voxelSSBO;
layout(binding=4) uniform sampler2DArray voxelTextureArray;
struct RaytraceResult {
    uint voxelValue;
    vec3 normal;
    vec3 rayPos;
    vec4 color;
};
uint hashChunkPos(ivec2 pos) {
    const uint p1 = 73856093u;
    const uint p2 = 19349663u;
    
    uint hash = (uint(pos.x) * p1) ^ (uint(pos.y) * p2);
    
    hash ^= hash >> 16;
    hash *= 0x85ebca6bu;
    hash ^= hash >> 13;
    hash *= 0xc2b2ae35u;
    hash ^= hash >> 16;

    return hash % 10000; 
}
uint normalToFaceIndex(vec3 normal) {
    if(normal.z>0.5) return 0u;
    if(normal.z<-0.5) return 1u;
    if(normal.x<-0.5) return 2u;
    if(normal.x>0.5) return 3u;
    if(normal.y>0.5) return 4u;
    if(normal.y<-0.5) return 5u;
}
int findChunk(ivec2 chunkPos) {
    uint hash = hashChunkPos(chunkPos);
    
    for (uint i = 0; i < 100u; i++) {
        uint index = (hash + i) % 10000u;
        

        if (chunkSSBO.chunkData[index].valid==1u&&ivec2(chunkSSBO.chunkData[index].chunkPos) == chunkPos) {
            return int(index);
        }
    }
    return -1;
}
uint traverseTree(uint32_t nodeIdx, ivec3 localPos,uint rootNodeIdx) {
    Node currentNode = voxelSSBO.nodes[nodeIdx];

    // For CHUNK_SIZE=64 and 4x4x4 branching, depth = 3
    // (generalized here)
    uint depth = 0u;
    for (uint s = ubo.CHUNK_SIZE; s > 1u; s /= 4u) {
        depth++;
    }

    for (int level = int(depth) - 1; level >= 0; --level) {
        if (currentNode.mask == 0ul) return 0u;
        if (currentNode.blockId != 0u) return currentNode.blockId;

        uvec3 child = (uvec3(localPos) >> uint(level * 2)) & uvec3(3u);
        uint bitPos = child.x * 16u + child.y * 4u + child.z;

        uint64_t bit = (1ul << bitPos);
        if ((currentNode.mask & bit) == 0ul) return 0u;

        uint64_t lowerBits = bit - 1ul;
        uint64_t masked = currentNode.mask & lowerBits;
        uint offset = bitCount(uint(masked)) + bitCount(uint(masked >> 32))+rootNodeIdx;

        currentNode = voxelSSBO.nodes[currentNode.firstChildIndex + offset];
    }

    return currentNode.blockId;
}

uint getVoxel(uint chunkIndex, ivec3 localPos)
{
    if (localPos.x < 0 || localPos.x >= int(ubo.CHUNK_SIZE) ||
        localPos.y < 0 || localPos.y >= int(ubo.CHUNK_SIZE) ||
        localPos.z < 0 || localPos.z >= int(ubo.CHUNK_SIZE)) {
        return 0u;
    }

    uint chunkVolume = ubo.CHUNK_SIZE * ubo.CHUNK_SIZE * ubo.CHUNK_SIZE;
    uint rootNodeIdx = chunkSSBO.chunkData[chunkIndex].gpuSlot * chunkVolume;

    return traverseTree(rootNodeIdx, localPos,rootNodeIdx);
}

vec2 getUVForFace(vec3 hitPos, vec3 normal) {
    vec3 localHit = hitPos - floor(hitPos);
    vec2 uv;
    
    // X faces
    if (abs(normal.x) > 0.5) {
        uv = vec2(1.0 - localHit.z, localHit.y); // Flip Z for proper orientation
    }
    // Y faces (top/bottom)
    else if (abs(normal.y) > 0.5) {
        uv = vec2(localHit.x, localHit.z);
    }
    // Z faces
    else {
        uv = vec2(localHit.x, localHit.y);
    }
    //Flip uv y coordinate
    uv.y = 1.0 - uv.y;
    return uv;
}

uint getFaceTextureLayer(uint voxelValue, vec3 normal) {
    uint face = normalToFaceIndex(normal);
    blockData b = ubo.blockDataArray[voxelValue];
    return (face < 4u) ? b.face0123[face] : b.face45pad[face - 4u];
}

vec4 sampleVoxelTexture(uint voxelValue, vec3 hitPos, vec3 normal) {
    vec2 uv = getUVForFace(hitPos, normal);
    uint layer = getFaceTextureLayer(voxelValue, normal);
    return texture(voxelTextureArray, vec3(uv, layer));
}
RaytraceResult raytrace(vec3 rayOrigin, vec3 rayDir) {
    const int MAX_STEPS = 1024; 
    int lastStepAxis = 0;
    ivec3 voxelPos = ivec3(floor(rayOrigin));
    ivec3 step = ivec3(sign(rayDir));
    
    vec3 tDelta = abs(1.0 / rayDir);
    
    vec3 tMax;
    for (int i = 0; i < 3; i++) {
        if (rayDir[i] > 0.0) {
            tMax[i] = (floor(rayOrigin[i]) + 1.0 - rayOrigin[i]) / rayDir[i];
        } else if (rayDir[i] < 0.0) {
            tMax[i] = (floor(rayOrigin[i]) - rayOrigin[i]) / rayDir[i];
        } else {
            tMax[i] = 1e30;
        }
    }
    
    for (int step_count = 0; step_count < MAX_STEPS; step_count++) {
        ivec2 chunkPos = ivec2(floor(float(voxelPos.x) / float(ubo.CHUNK_SIZE)), floor(float(voxelPos.z) / float(ubo.CHUNK_SIZE)));
        ivec3 localPos = voxelPos - ivec3(chunkPos.x, 0, chunkPos.y) * int(ubo.CHUNK_SIZE);
        
        int chunkIndex = findChunk(chunkPos);
        
        if (chunkIndex >= 0) {
            uint voxelValue = getVoxel(uint(chunkIndex), localPos);
            if (voxelValue != 0u) {

                float tHit = tMax[lastStepAxis] - tDelta[lastStepAxis];
                vec3 rayHitPos = rayOrigin + rayDir * tHit;

                vec3 normal = vec3(0.0);
                if (lastStepAxis == 0) normal.x = -float(step.x);
                else if (lastStepAxis == 1) normal.y = -float(step.y);
                else normal.z = -float(step.z);

                vec4 texColor = sampleVoxelTexture(voxelValue, rayHitPos, normal);

                if (texColor.a > 0.01) {
                    return RaytraceResult(
                        voxelValue,
                        normal,
                        rayHitPos,
                        texColor
                    );
                }
            }
        }
        else{
            return RaytraceResult(0u, vec3(0.0), vec3(0.0), vec4(0.0));
        }
        
        if (tMax.x < tMax.y) {
            if (tMax.x < tMax.z) {
                voxelPos.x += step.x;
                tMax.x += tDelta.x;
                lastStepAxis = 0; 
            } else {
                voxelPos.z += step.z;
                tMax.z += tDelta.z;
                lastStepAxis = 2; 
            }
        } else {
            if (tMax.y < tMax.z) {
                voxelPos.y += step.y;
                tMax.y += tDelta.y;
                lastStepAxis = 1;
            } else {
                voxelPos.z += step.z;
                tMax.z += tDelta.z;
                lastStepAxis = 2; 
            }
        }
    }
    
    return RaytraceResult(0u, vec3(0.0), vec3(0.0), vec4(0.0));
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size  = imageSize(img);

    if (pixel.x >= size.x || pixel.y >= size.y)
        return;

    vec2 uv = vec2(pixel) / vec2(size);
    vec2 ndc = uv * 2.0 - 1.0;
    ndc.y *= -1.0;
    vec4 clip = vec4(ndc, -1.0, 1.0);

    vec4 eye = inverse(ubo.proj) * clip;
    eye.z = -1.0;
    eye.w = 0.0;

    vec4 world = inverse(ubo.view) * eye;
    vec3 rayDir = normalize(world.xyz);
    vec3 rayOrigin = ubo.cameraPos;
    
    RaytraceResult result = raytrace(rayOrigin, rayDir);
    
    if (result.voxelValue != 0u) {
        // Apply simple lighting to texture
        vec3 normalizedNormal = normalize(result.normal);
        float brightness = dot(normalizedNormal, vec3(0.0, 1.0, 0.0)) * 0.4 + 0.6;
        vec4 litColor = vec4(result.color.rgb * brightness, result.color.a);
        imageStore(img, pixel, litColor);
    } else {
        imageStore(img, pixel, vec4(1.0, 0.749, 0.0, 1.0));
    }
}