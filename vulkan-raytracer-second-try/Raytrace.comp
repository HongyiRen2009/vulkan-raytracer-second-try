//GLSL version to use
#version 460
#extension GL_KHR_vulkan_glsl: enable
//size of a workgroup for compute
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, rgba8) uniform writeonly image2D img;
layout(binding = 1) uniform UniformBufferObject
{
    mat4 view;
    mat4 proj;
    vec3 cameraPos;
} ubo;
const vec3 boxMin = vec3(-0.5, 0, 1.0);
const vec3 boxMax = vec3(0.5, 1.0, 2.0);
bool intersectBox(in vec3 rayOrigin, in vec3 rayDir, in vec3 boxMin, in vec3 boxMax, out float tMinOut, out float tMaxOut) {
    // Calculate the inverse direction once to avoid division by zero and for efficiency
    vec3 invDir = 1.0 / rayDir;

    // Calculate intersection distances (t values) for all six planes
    vec3 tbot = invDir * (boxMin - rayOrigin);
    vec3 ttop = invDir * (boxMax - rayOrigin);

    // Ensure tmin is always the lesser t value for each axis
    vec3 tmin = min(ttop, tbot);
    vec3 tmax = max(ttop, tbot);

    // Find the maximum of the tmin values and the minimum of the tmax values 
    // to determine the overall entry and exit points for the box
    float t0 = max(max(tmin.x, tmin.y), tmin.z);
    float t1 = min(min(tmax.x, tmax.y), tmax.z);

    // Store the results
    tMinOut = t0;
    tMaxOut = t1;

    // The ray intersects the box if t1 is greater than t0, and t1 is greater than 0 
    // (ensures intersection is in front of the ray's origin)
    return t1 > max(t0, 0.0);
}


void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size  = imageSize(img);

    if (pixel.x >= size.x || pixel.y >= size.y)
        return;

    vec2 uv = vec2(pixel) / vec2(size);
    vec2 ndc = uv * 2.0 - 1.0;
    ndc.y *= -1.0; // Flip coordinates for Vulkan
    vec4 clip = vec4(ndc, -1.0, 1.0);

    vec4 eye = inverse(ubo.proj) * clip;
    eye.z = -1.0;
    eye.w = 0.0;

    vec4 world = inverse(ubo.view) * eye;
    vec3 rayDir = normalize(world.xyz);

    vec2 tMinMax;
    if (intersectBox(ubo.cameraPos, rayDir, boxMin, boxMax, tMinMax.x, tMinMax.y)) {
        float t = tMinMax.x; // Use the nearest intersection
        vec3 hitPoint = ubo.cameraPos + t * rayDir;
        imageStore(img, pixel, vec4(0.0,1.0,0.0, 1.0));
    } else {
        imageStore(img, pixel, vec4(0.0)); // Background color
    }
}