#version 460
#extension GL_KHR_vulkan_glsl: enable
layout (local_size_x = 16, local_size_y = 16) in;

layout (binding = 0) uniform sampler2D currentFrame;
layout (binding = 1) uniform sampler2D previousFrame;
layout (binding = 2) uniform TAAParams {
	vec4 frameSize; // x = width, y = height, z = 1/width, w = 1/height
    vec2 jitter;
} ubo;
layout (binding = 3) uniform sampler2D velocityBuffer;
layout (binding = 4, rgba8) uniform writeonly image2D outputFrame;
layout (binding = 5) uniform sampler2D depthBuffer;
layout(push_constant) uniform PushConstants {
	int TAAToggle;
    int cameraMoved;
} TAAPushConstants;


void main() {
    ivec2 pixelCoords = ivec2(gl_GlobalInvocationID.xy);
    ivec2 sizeI = textureSize(currentFrame, 0);
    vec2 size = vec2(sizeI);
    if (pixelCoords.x >= size.x || pixelCoords.y >= size.y) return;
    vec2 currentUV = (vec2(pixelCoords)) / size;
    vec2 unjitteredUV = currentUV - ubo.jitter.xy/size;
    vec3 currentColor = texture(currentFrame, unjitteredUV).rgb;
    vec2 motionToPrev = texture(velocityBuffer, unjitteredUV).rg;
    vec3 skyColor =vec3(1.0, 0.749, 0.0);
    float depth = texture(depthBuffer, unjitteredUV).r;
    vec3 neighborhoodMin = currentColor;
    vec3 neighborhoodMax = currentColor;
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            vec3 sampleColor = texture(currentFrame, unjitteredUV + vec2(x, y) * ubo.frameSize.zw).rgb;
            neighborhoodMin = min(neighborhoodMin, sampleColor);
            neighborhoodMax = max(neighborhoodMax, sampleColor);
        }
    }
    if(distance(neighborhoodMin,skyColor)<0.1&&distance(neighborhoodMax,skyColor)<0.1) {
        imageStore(outputFrame, pixelCoords, vec4(currentColor, 1.0));
        return;
    }
    if(TAAPushConstants.TAAToggle == 1) {
        imageStore(outputFrame, pixelCoords, vec4(currentColor, 1.0));
        return;
    }
    // Reproject to previous frame using motion vector
    vec2 prevUV = unjitteredUV + motionToPrev+vec2(0.5)/size;
    bool isValidReprojection = all(greaterThanEqual(prevUV, vec2(0.0))) && all(lessThanEqual(prevUV, vec2(1.0)));

    vec4 prevData;
    vec3 prevColor;
    float frameCount;
    float maxFrameCount = 32.0;
    if(isValidReprojection) {
        // Sample from reprojected location
        prevData = texture(previousFrame, prevUV);
        prevColor = prevData.rgb;
        if((frameCount<32.0&&depth>500)||TAAPushConstants.cameraMoved==1u) {
            prevColor = clamp(prevColor, neighborhoodMin - vec3(0.02), neighborhoodMax + vec3(0.02));
        }
        frameCount = prevData.a * maxFrameCount;
        if(frameCount>=maxFrameCount&&TAAPushConstants.cameraMoved == 1) {
            // If camera moved and history is old, reset it
            frameCount = maxFrameCount-1.0;
        }
    } else {
        // Out of bounds or camera moved: reset history
        prevColor = currentColor;
        frameCount = 0.0;
    }

    float historyWeight = clamp(frameCount / maxFrameCount, 0.0, 1.0);
    vec3 finalColor = mix(currentColor, prevColor, historyWeight);
    imageStore(outputFrame, pixelCoords, vec4(finalColor, (frameCount+1)/maxFrameCount));
}
