#version 460
#extension GL_KHR_vulkan_glsl: enable
layout (local_size_x = 16, local_size_y = 16) in;

layout (binding = 0, rgba8) uniform readonly image2D currentFrame;
layout (binding = 1, rgba8) uniform readonly image2D previousFrame;
layout (binding = 2) uniform TAAParams {
	vec4 frameSize; // x = width, y = height, z = 1/width, w = 1/height
    vec2 jitter;
} ubo;
layout (binding = 3, rg16f) uniform readonly image2D velocityBuffer;
layout (binding = 4, rgba8) uniform writeonly image2D outputFrame;

layout(push_constant) uniform PushConstants {
	int TAAToggle;
    int cameraMoved;
} TAAPushConstants;


void main() {
    ivec2 pixelCoords = ivec2(gl_GlobalInvocationID.xy);
    ivec2 sizeI = imageSize(currentFrame);
    vec2 size = vec2(sizeI);
    if (pixelCoords.x >= size.x || pixelCoords.y >= size.y) return;

    vec3 currentColor = imageLoad(currentFrame, pixelCoords).rgb;
    vec2 motionToPrev = imageLoad(velocityBuffer, pixelCoords).rg;

    vec3 neighborhoodMin = currentColor;
    vec3 neighborhoodMax = currentColor;
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            ivec2 sampleCoords = clamp(pixelCoords + ivec2(x, y), ivec2(0), sizeI - ivec2(1));
            vec3 sampleColor = imageLoad(currentFrame, sampleCoords).rgb;
            neighborhoodMin = min(neighborhoodMin, sampleColor);
            neighborhoodMax = max(neighborhoodMax, sampleColor);
        }
    }

    vec2 currentUV = (vec2(pixelCoords)) / size;
    if(TAAPushConstants.TAAToggle == 1) {
        imageStore(outputFrame, pixelCoords, vec4(currentColor, 1.0));
        return;
    }

    // Reproject to previous frame using motion vector
    vec2 prevUV = currentUV + motionToPrev;
    vec2 prevPixelCoords = prevUV * size;
    ivec2 prevPixelCoordsInt = ivec2(round(prevPixelCoords));

    // Check if reprojected coordinates are within bounds
    bool isValidReprojection = prevPixelCoordsInt.x >= 0 && prevPixelCoordsInt.x < sizeI.x &&
                               prevPixelCoordsInt.y >= 0 && prevPixelCoordsInt.y < sizeI.y;

    vec4 prevData;
    vec3 prevColor;
    float frameCount;

    if(isValidReprojection) {
        // Sample from reprojected location
        prevData = imageLoad(previousFrame, prevPixelCoordsInt);
        prevColor = prevData.rgb;
        prevColor = clamp(prevColor, neighborhoodMin - vec3(0.02), neighborhoodMax + vec3(0.02));
        float maxFrameCount = 16.0;
        frameCount = prevData.a * maxFrameCount;
        if(frameCount>=16.0&&TAAPushConstants.cameraMoved == 1) {
            // If camera moved and history is old, reset it
            frameCount = 15.0;
        }
    } else {
        // Out of bounds or camera moved: reset history
        prevColor = currentColor;
        frameCount = 0.0;
    }

    float maxFrameCount = 16.0;
    float historyWeight = clamp(frameCount / maxFrameCount, 0.0, 1.0);
    vec3 finalColor = mix(currentColor, prevColor, historyWeight);
    imageStore(outputFrame, pixelCoords, vec4(finalColor, (frameCount+1)/maxFrameCount));
}
