#version 460
#extension GL_KHR_vulkan_glsl: enable
layout (local_size_x = 16, local_size_y = 16) in;

layout (binding = 0, rgba8) uniform readonly image2D currentFrame;
layout (binding = 1, rgba8) uniform readonly image2D previousFrame;
layout (binding = 2) uniform TAAParams {
	vec4 frameSize; // x = width, y = height, z = 1/width, w = 1/height
    vec2 jitter;
} ubo;
layout (binding = 3, rg16f) uniform readonly image2D velocityBuffer;
layout (binding = 4, rgba8) uniform writeonly image2D outputFrame;

layout(push_constant) uniform PushConstants {
	int TAAToggle;
} TAAPushConstants;


void main() {
    ivec2 pixelCoords = ivec2(gl_GlobalInvocationID.xy);
    ivec2 sizeI = imageSize(currentFrame);
    vec2 size = vec2(sizeI);
    if (pixelCoords.x >= size.x || pixelCoords.y >= size.y) return;

    vec3 currentColor = imageLoad(currentFrame, pixelCoords).rgb;
    vec2 motionToPrev = imageLoad(velocityBuffer, pixelCoords).rg;
    
    vec2 currentUV = (vec2(pixelCoords) + 0.5) / size;
    if(TAAPushConstants.TAAToggle == 1) {
        imageStore(outputFrame, pixelCoords, vec4(currentColor, 1.0));
        return;
    }
    vec2 prevUV = currentUV + motionToPrev;

    // 1. Out of bounds check
    if(prevUV.x < 0.0 || prevUV.x > 1.0 || prevUV.y < 0.0 || prevUV.y > 1.0) {
        imageStore(outputFrame, pixelCoords, vec4(currentColor, 1.0));
        return;
    }

    // 2. Bilinear history sampling for stable reprojection
    vec2 prevPixel = prevUV * size - 0.5;
    ivec2 p0 = ivec2(floor(prevPixel));
    ivec2 p1 = p0 + ivec2(1, 0);
    ivec2 p2 = p0 + ivec2(0, 1);
    ivec2 p3 = p0 + ivec2(1, 1);
    p0 = clamp(p0, ivec2(0), sizeI - ivec2(1));
    p1 = clamp(p1, ivec2(0), sizeI - ivec2(1));
    p2 = clamp(p2, ivec2(0), sizeI - ivec2(1));
    p3 = clamp(p3, ivec2(0), sizeI - ivec2(1));
    vec2 f = fract(prevPixel);

    vec3 c00 = imageLoad(previousFrame, p0).rgb;
    vec3 c10 = imageLoad(previousFrame, p1).rgb;
    vec3 c01 = imageLoad(previousFrame, p2).rgb;
    vec3 c11 = imageLoad(previousFrame, p3).rgb;
    vec3 prevColor = mix(mix(c00, c10, f.x), mix(c01, c11, f.x), f.y);

    // 3. Neighborhood clipping to reduce ghosting
    vec3 minNeighbor = currentColor;
    vec3 maxNeighbor = currentColor;

    for(int dy = -1; dy <= 1; dy++) {
        for(int dx = -1; dx <= 1; dx++) {
            ivec2 neighborCoord = pixelCoords + ivec2(dx, dy);
            neighborCoord = clamp(neighborCoord, ivec2(0), sizeI - ivec2(1));
            vec3 neighborColor = imageLoad(currentFrame, neighborCoord).rgb;
            minNeighbor = min(minNeighbor, neighborColor);
            maxNeighbor = max(maxNeighbor, neighborColor);
        }
    }

    prevColor = clamp(prevColor, minNeighbor, maxNeighbor);

    const float temporalSampleCount = 9.0;
    const float historyWeight = (temporalSampleCount - 1.0) / temporalSampleCount;
    vec3 finalColor = mix(currentColor, prevColor, historyWeight);
    imageStore(outputFrame, pixelCoords, vec4(finalColor, 1.0));
}
